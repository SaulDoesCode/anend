     let z = i / (w * rows);
-    b2[p.u2.x + z * p.u2.y + r * p.u2.z + c] = b1[p.u1.x + z * p.u1.y + r * p.u1.z + c];
+    // rows in blocks of `u0.w` (0: one block): block b, row r within it
+    var sr = r * p.u1.z;
+    var dr = r * p.u2.z;
+    if (p.u0.w > 0u) {
+        let blk = r / p.u0.w;
+        let rr = r % p.u0.w;
+        sr = blk * p.u1.w + rr * p.u1.z;
+        dr = blk * p.u2.w + rr * p.u2.z;
+    }
+    b2[p.u2.x + z * p.u2.y + dr + c] = b1[p.u1.x + z * p.u1.y + sr + c];
 }
