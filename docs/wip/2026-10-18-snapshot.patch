+        let heads = [HeadSpec::single("a", &["x", "y"])];
+        let mut net = Net::with_gen(cfg.clone(), &heads, Some(GenSpec::new("next")), 4).unwrap();
+        let mut r = Rng::new(10);
+        for (_, t) in net.params_mut() { for v in t.iter_mut() { *v += r.symmetric(0.05); } }
