+          sudo apt-get install -y --no-install-recommends pkg-config libwebkit2gtk-4.1-dev libxdo-dev
       - uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: wasm32-unknown-unknown
       - uses: Swatinem/rust-cache@v2
-      - name: build the app and the hub
-        run: cargo build --release --locked --workspace
+      - name: the web app (built into the hub)
+        shell: bash
+        run: |
+          cargo install --locked wasm-bindgen-cli --version 0.2.129
+          sh app/web/build.sh
+      - name: build the desktop app and the hub
+        run: cargo build --release --locked -p anend-app -p anend-hub
 
       - name: package
         shell: bash
@@ -45,7 +52,7 @@ jobs:
           dir=anend-${{ github.ref_name }}-${{ matrix.name }}
           dir=${dir//\//-}
           mkdir "$dir"
