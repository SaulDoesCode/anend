+#[test]
+fn gematria_files_keep_their_channels_bit_exact() {
+    let clf = Classifier::from_bytes(include_bytes!("testdata/v2_gematria.anendcls")).unwrap();
+    assert!(clf.net.cfg.letters && clf.net.cfg.words && clf.net.cfg.side);
