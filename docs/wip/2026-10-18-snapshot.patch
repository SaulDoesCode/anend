+    let p: Vec<u32> = clf.predict("slate and plum", &[])[0]
+        .probs
+        .iter()
+        .map(|v| v.to_bits())
+        .collect();
+    assert_eq!(p, [1057944601, 1055004622]);
+    assert_eq!(
+        Classifier::from_bytes(&clf.to_bytes())
+            .unwrap()
+            .logits("granite and peach, 1234!", &[]),
+        l
+    );
+}
