diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 2454cea..7c67136 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -1,6 +1,6 @@
 name: release
 
-# Push a tag like v0.2.0 to build the app and the hub for Linux and Windows and
+# Push a tag like v0.2.0 to build the desktop app (anend-app) and the hub for Linux and Windows and
 # attach them to a GitHub release of that name. "Run workflow" on the Actions tab
