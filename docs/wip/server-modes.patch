+fn own_save(depot: &Depot, id: &str) -> Option<Save> {
+    let u = me(depot)?;
+    let s = hub().store.save(id).ok().flatten()?;
+    (u.is_admin() || u.name.eq_ignore_ascii_case(&s.author)).then_some(s)
+}
