+/// a file name for a save's download
+fn file_name(s: &Save) -> String {
+    let n: String = s
+        .name
+        .chars()
+        .map(|c| {
+            if c.is_alphanumeric() || c == ' ' || c == '-' || c == '_' {
+                c
+            } else {
+                '-'
+            }
+        })
+        .collect();
+    let n = n.trim();
+    format!("{}.redb", if n.is_empty() { s.id.as_str() } else { n })
+}
