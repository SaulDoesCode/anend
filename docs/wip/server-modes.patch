+fn visible(depot: &Depot, id: &str) -> Option<Save> {
+    let s = hub().store.save(id).ok().flatten()?;
+    let mine = me(depot).is_some_and(|u| u.is_admin() || u.name.eq_ignore_ascii_case(&s.author));
+    (s.status == Status::Approved || mine).then_some(s)
+}
