+    fn legacy_maps_migrate_once() {
+        let (s, path) = store("legacy");
+        let k = s.saturate_new("listen").unwrap();
+        let rows = serde_json::json!([
+            ["a free text", 1.5, 2.25, -3.0, {}],
+            ["a big one", 0.0, 0.0, 0.0, {"size": 1.0, "color": "#ff0000"}],
+            ["listen", 4.0, 5.0, 6.0, {"key": "0"}],
+            ["gone", 7.0, 8.0, 9.0, {"key": "9,9"}],
+            ["old number key", 1.0, 1.0, 1.0, {"key": 0}],
