+        assert!(s.places_of(&n).unwrap().is_empty());
+
+        // forgetting a memory or deleting a note drops its placements
+        s.place(&n, &p3).unwrap();
+        s.forget(match &b {
+            Ref::Memory(k) => k,
+            _ => unreachable!(),
+        })
+        .unwrap();
+        assert!(s.places_of(&b).unwrap().is_empty());
