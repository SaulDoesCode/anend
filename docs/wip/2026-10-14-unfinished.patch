+//! Places: where entries stand in the space. A placed text is a normal memory (or note)
+//! entry; its transforms are kept here, each one bit packed into a small fixed value under
+//! the entry's ref, so the same entry can stand in several places (and several maps) while
+//! identical placements collapse into one.
+//!
+//! | table | maps |
+//! |---|---|
+//! | `memory places` | ref -> packed placements (multimap: a set per entry) |
+//! | `place map entries` | map id -> refs placed in it (multimap, the reverse index) |
+//! | `place maps` | map id (u16) -> `{"name": ...}` JSON |
+//!
+//! A ref is `Ref::bytes`: a memory key or `note:<key>`, as in the lists.
+//!
+//! **The packed value** (`PACKED` = 36 bytes, little endian, version 1):
+//!
+//! | bytes | field |
+//! |---|---|
+//! | 0 | version, 1 (an unknown version doesn't unpack, and is left alone) |
+//! | 1 | kind: 0 text, 1 cube, 2 long block, 3 brick, 4 model (glTF; reserved) |
+//! | 2–3 | map id, u16 (0 is never a map) |
+//! | 4 | flags: 1 pinned, 2 hidden, 4 spread (a spread text: laid out by its sums when not pinned); the rest reserved, kept as they are |
+//! | 5 | reserved, 0 |
+//! | 6–17 | position, 3 × f32 |
+//! | 18–21 | rotation, smallest three: bits 30–31 the index of the largest component of the unit quaternion (x y z w), made positive and left out; the other three in order, 10 bits each (bits 20–29, 10–19, 0–9), each `round(v·√2·511) + 511` |
+//! | 22–27 | scale, 3 × f16 (a text uses x as its em size) |
+//! | 28–31 | colour, RGBA8 |
+//! | 32–35 | asset id, u32: 0 none; for a model, the asset in the (reserved) assets table |
+//!
+//! Packing is canonical, so the same placement always gives the same bytes: −0 is +0, a
+//! NaN is 0 (a NaN scale is 1), positions beyond f32 stay ±f32::MAX, scales are clamped to
+//! ±65504 (f16's largest) and rounded to nearest even, a rotation is normalised first (a
+//! zero or broken one is the identity), and `pack(unpack(b)) == b` for what `pack` made.
+//! Rotation is good to about 0.1°, positions are exact, scales have 11 significant bits.
+//!
+//! Moving a placement is removing the old value and inserting the new in one transaction.
+//! The reverse index holds a ref under a map while the ref has any placement in it, so
+//! "what's in map X" is a range read plus one lookup per entry, not a scan; a map id key
+//! prefix on the places table instead would have made "where is this entry" the scan, and
+//! that's what the space asks most (and what forgetting needs).
+//!
+//! **Assets (reserved, not built):** a model placement (kind 4) names its glTF asset by the
+//! asset id; the entry it's placed under is the model's memory entry (its name, so it can
+//! be searched, listed and summed like any text). A later `place assets` table would map
+//! asset id (u32) -> `{name, mime, size, hash}` JSON and a `place asset bytes` table the
+//! id -> the .glb bytes (or a path for big ones), deduplicated by content hash; bundles
+//! would carry them base64 with a size limit on the hub. Blocks (kinds 1–3) need no asset:
+//! the kind, scale and colour are the whole of them.
+//!
+//! **Migration:** maps the space kept before places, JSON rows `[text, x, y, z, {size,
+//! color, key}]` under `map:<name>` settings, become place maps by
+//! `Store::migrate_legacy_maps`: free texts are saturated (or found) and placed, memory
+//! texts placed as pinned spread texts. The old settings are left as they were; the names
+//! done are listed in the `place maps migrated` setting so it happens once.
+
+use redb::{
+    MultimapTableDefinition, ReadableDatabase, ReadableMultimapTable, ReadableTable, TableDefinition, WriteTransaction,
+};
+use serde::{Deserialize, Serialize};
+
+use crate::memory::{MEMORIES, Ref};
+use crate::store::{NOTES, Store, StoreResult};
+
+pub const PLACES: MultimapTableDefinition<&[u8], &[u8]> = MultimapTableDefinition::new("memory places");
+pub const PLACED: MultimapTableDefinition<u16, &[u8]> = MultimapTableDefinition::new("place map entries");
+pub const PLACE_MAPS: TableDefinition<u16, &[u8]> = TableDefinition::new("place maps");
+
+pub const VERSION: u8 = 1;
+pub const PACKED: usize = 36;
+
+pub const PINNED: u8 = 1;
+pub const HIDDEN: u8 = 2;
+pub const SPREAD: u8 = 4;
+
+/// the setting listing the legacy maps already made place maps
+pub const MIGRATED: &str = "place maps migrated";
+/// where the space kept its maps before
+pub const LEGACY_PREFIX: &str = "map:";
+
+fn err(e: impl std::fmt::Display) -> String {
+    e.to_string()
+}
+
+pub fn create_tables(txn: &WriteTransaction) -> StoreResult<()> {
+    txn.open_multimap_table(PLACES).map_err(err)?;
+    txn.open_multimap_table(PLACED).map_err(err)?;
+    txn.open_table(PLACE_MAPS).map_err(err)?;
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Default)]
+#[repr(u8)]
+pub enum Kind {
+    #[default]
+    Text = 0,
+    Cube = 1,
+    LongBlock = 2,
+    Brick = 3,
+    /// a glTF model (reserved: nothing places these yet)
+    Model = 4,
+}
+
+impl Kind {
+    pub fn from_u8(b: u8) -> Option<Kind> {
+        Some(match b {
+            0 => Kind::Text,
+            1 => Kind::Cube,
+            2 => Kind::LongBlock,
+            3 => Kind::Brick,
+            4 => Kind::Model,
+            _ => return None,
+        })
+    }
+}
+
+/// one placement of an entry
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Place {
+    pub kind: Kind,
+    pub map: u16,
+    pub flags: u8,
+    pub pos: [f32; 3],
+    /// a quaternion, x y z w
+    pub rot: [f32; 4],
+    pub scale: [f32; 3],
+    pub color: [u8; 4],
+    pub asset: u32,
+}
+
+pub const IDENTITY: [f32; 4] = [0.0, 0.0, 0.0, 1.0];
+
+impl Place {
+    /// a text of em size `size`, facing the camera (no rotation of its own)
+    pub fn text(map: u16, pos: [f32; 3], size: f32, color: [u8; 4], flags: u8) -> Place {
+        Place {
+            kind: Kind::Text,
+            map,
+            flags,
+            pos,
+            rot: IDENTITY,
+            scale: [size, size, size],
+            color,
+            asset: 0,
+        }
+    }
+
+    pub fn pinned(&self) -> bool {
+        self.flags & PINNED != 0
+    }
+
+    pub fn hidden(&self) -> bool {
+        self.flags & HIDDEN != 0
+    }
+
+    pub fn spread(&self) -> bool {
+        self.flags & SPREAD != 0
+    }
+
+    pub fn pack(&self) -> [u8; PACKED] {
+        let mut b = [0u8; PACKED];
+        b[0] = VERSION;
+        b[1] = self.kind as u8;
+        b[2..4].copy_from_slice(&self.map.to_le_bytes());
+        b[4] = self.flags;
+        for (i, v) in self.pos.iter().enumerate() {
+            b[6 + i * 4..10 + i * 4].copy_from_slice(&canon_f32(*v).to_le_bytes());
+        }
+        b[18..22].copy_from_slice(&pack_rotation(self.rot).to_le_bytes());
+        for (i, v) in self.scale.iter().enumerate() {
+            b[22 + i * 2..24 + i * 2].copy_from_slice(&f32_to_f16(canon_scale(*v)).to_le_bytes());
+        }
+        b[28..32].copy_from_slice(&self.color);
+        b[32..36].copy_from_slice(&self.asset.to_le_bytes());
+        b
+    }
+
+    /// `None` for a value of another size, version or kind
+    pub fn unpack(b: &[u8]) -> Option<Place> {
+        if b.len() != PACKED || b[0] != VERSION {
+            return None;
+        }
+        let f32_at = |i: usize| f32::from_le_bytes([b[i], b[i + 1], b[i + 2], b[i + 3]]);
+        let f16_at = |i: usize| f16_to_f32(u16::from_le_bytes([b[i], b[i + 1]]));
+        Some(Place {
+            kind: Kind::from_u8(b[1])?,
+            map: u16::from_le_bytes([b[2], b[3]]),
+            flags: b[4],
+            pos: [f32_at(6), f32_at(10), f32_at(14)],
+            rot: unpack_rotation(u32::from_le_bytes([b[18], b[19], b[20], b[21]])),
+            scale: [f16_at(22), f16_at(24), f16_at(26)],
+            color: [b[28], b[29], b[30], b[31]],
+            asset: u32::from_le_bytes([b[32], b[33], b[34], b[35]]),
+        })
+    }
+}
+
+/// the map id of a packed value
+pub fn map_of(b: &[u8]) -> Option<u16> {
+    (b.len() == PACKED).then(|| u16::from_le_bytes([b[2], b[3]]))
+}
+
+/// a packed value with another map id
+pub fn with_map(b: &[u8], map: u16) -> Vec<u8> {
+    let mut out = b.to_vec();
+    if out.len() == PACKED {
+        out[2..4].copy_from_slice(&map.to_le_bytes());
+    }
+    out
+}
+
+fn canon_f32(v: f32) -> f32 {
+    if v.is_nan() || v == 0.0 {
+        0.0
+    } else {
+        v.clamp(f32::MIN, f32::MAX)
+    }
+}
+
+fn canon_scale(v: f32) -> f32 {
+    if v.is_nan() {
+        1.0
+    } else if v == 0.0 {
+        0.0
+    } else {
+        v.clamp(-65504.0, 65504.0)
+    }
+}
+
+// ---------------------------------------------------------------- f16
+
+/// IEEE half precision, rounded to nearest even
+pub fn f32_to_f16(v: f32) -> u16 {
+    let x = v.to_bits();
+    let sign = ((x >> 16) & 0x8000) as u16;
+    let exp = ((x >> 23) & 0xff) as i32;
+    let man = x & 0x7f_ffff;
+    if exp == 0xff {
+        return sign | 0x7c00 | if man != 0 { 0x200 } else { 0 };
+    }
+    let e = exp - 127 + 15;
+    if e >= 0x1f {
+        return sign | 0x7c00;
+    }
+    if e <= 0 {
+        let shift = (14 - e) as u32;
+        if shift > 24 {
+            return sign;
+        }
+        let full = man | 0x80_0000;
+        let half = 1u32 << (shift - 1);
+        let rest = full & ((1u32 << shift) - 1);
+        let mut m = full >> shift;
+        if rest > half || (rest == half && m & 1 == 1) {
+            m += 1;
+        }
+        return sign | m as u16;
+    }
+    let mut h = ((e as u32) << 10) | (man >> 13);
+    let rest = man & 0x1fff;
+    if rest > 0x1000 || (rest == 0x1000 && h & 1 == 1) {
+        h += 1;
+    }
+    sign | h as u16
+}
+
+pub fn f16_to_f32(h: u16) -> f32 {
+    let sign = ((h & 0x8000) as u32) << 16;
+    let e = ((h >> 10) & 0x1f) as u32;
+    let m = (h & 0x3ff) as u32;
+    let bits = match (e, m) {
+        (0, 0) => sign,
+        (0, m) => {
+            let v = m as f32 * (1.0 / 16_777_216.0);
+            return if sign != 0 { -v } else { v };
+        }
+        (0x1f, 0) => sign | 0x7f80_0000,
+        (0x1f, m) => sign | 0x7fc0_0000 | (m << 13),
+        (e, m) => sign | ((e + 112) << 23) | (m << 13),
+    };
+    f32::from_bits(bits)
+}
+
+// ---------------------------------------------------------------- rotation
+
+const STEPS: f32 = 511.0;
+
+/// a unit quaternion (x y z w) in 32 bits: the smallest three
+pub fn pack_rotation(q: [f32; 4]) -> u32 {
+    let len = q.iter().map(|v| v * v).sum::<f32>().sqrt();
+    let q = if len.is_finite() && len > 1e-6 {
+        q.map(|v| v / len)
+    } else {
+        IDENTITY
+    };
+    let mut big = 0;
+    for i in 1..4 {
+        if q[i].abs() > q[big].abs() {
+            big = i;
+        }
+    }
+    let q = if q[big] < 0.0 { q.map(|v| -v) } else { q };
+    let mut out = (big as u32) << 30;
+    let mut shift = 20;
+    for (i, v) in q.iter().enumerate() {
+        if i == big {
+            continue;
+        }
+        let s = (v * std::f32::consts::SQRT_2 * STEPS).round().clamp(-STEPS, STEPS) as i32 + 511;
+        out |= (s as u32) << shift;
+        shift -= 10;
+    }
+    out
+}
+
+pub fn unpack_rotation(r: u32) -> [f32; 4] {
+    let big = (r >> 30) as usize;
+    let mut q = [0f32; 4];
+    let mut shift = 20;
+    let mut sum = 0.0;
+    for (i, slot) in q.iter_mut().enumerate() {
+        if i == big {
+            continue;
+        }
+        let s = ((r >> shift) & 0x3ff).min(1022) as i32 - 511;
+        *slot = s as f32 / STEPS * std::f32::consts::FRAC_1_SQRT_2;
+        sum += *slot * *slot;
+        shift -= 10;
+    }
+    q[big] = (1.0 - sum).max(0.0).sqrt();
+    q
+}
+
+// ---------------------------------------------------------------- colours
+
+/// `#rgb`, `#rgba`, `#rrggbb` or `#rrggbbaa`
+pub fn parse_hex_color(s: &str) -> Option<[u8; 4]> {
+    let h = s.trim().trim_start_matches('#');
+    let nib = |c: u8| (c as char).to_digit(16).map(|d| d as u8);
+    let b = h.as_bytes();
+    if !h.is_ascii() {
+        return None;
+    }
+    match b.len() {
+        3 | 4 => {
+            let mut out = [255u8; 4];
+            for (i, c) in b.iter().enumerate() {
+                out[i] = nib(*c)? * 17;
+            }
+            Some(out)
+        }
+        6 | 8 => {
+            let mut out = [255u8; 4];
+            for i in 0..b.len() / 2 {
+                out[i] = nib(b[i * 2])? * 16 + nib(b[i * 2 + 1])?;
+            }
+            Some(out)
+        }
+        _ => None,
+    }
+}
+
+/// `#rrggbb`, with `aa` when it isn't opaque
+pub fn hex_color(c: [u8; 4]) -> String {
+    if c[3] == 255 {
+        format!("#{:02x}{:02x}{:02x}", c[0], c[1], c[2])
+    } else {
+        format!("#{:02x}{:02x}{:02x}{:02x}", c[0], c[1], c[2], c[3])
+    }
+}
+
+// ---------------------------------------------------------------- the store
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PlaceMap {
+    pub id: u16,
+    pub name: String,
+}
+
+#[derive(Serialize, Deserialize, Default)]
+struct Meta {
+    name: String,
+}
+
+fn check_name(name: &str) -> StoreResult<String> {
+    let n = name.trim();
+    if n.is_empty() || n.chars().count() > 200 {
+        return Err("a map's name is 1 to 200 characters".into());
+    }
+    Ok(n.to_string())
+}
+
+fn exists(txn: &WriteTransaction, r: &Ref) -> StoreResult<bool> {
+    Ok(match r {
+        Ref::Memory(k) => txn.open_table(MEMORIES).map_err(err)?.get(k.as_slice()).map_err(err)?.is_some(),
+        Ref::Note(k) => txn.open_table(NOTES).map_err(err)?.get(k.as_str()).map_err(err)?.is_some(),
+    })
+}
+
+fn map_exists(txn: &WriteTransaction, map: u16) -> StoreResult<bool> {
+    Ok(txn.open_table(PLACE_MAPS).map_err(err)?.get(map).map_err(err)?.is_some())
+}
+
+/// adds one packed placement and its reverse index entry; true if it wasn't there
+fn insert(txn: &WriteTransaction, rb: &[u8], packed: &[u8]) -> StoreResult<bool> {
+    let map = map_of(packed).ok_or("that isn't a packed placement")?;
+    let new = !txn
+        .open_multimap_table(PLACES)
+        .map_err(err)?
+        .insert(rb, packed)
+        .map_err(err)?;
+    txn.open_multimap_table(PLACED).map_err(err)?.insert(map, rb).map_err(err)?;
+    Ok(new)
+}
+
+/// removes one packed placement, and the ref from its map's index when it was its last
+/// placement there; true if it was there
+fn remove(txn: &WriteTransaction, rb: &[u8], packed: &[u8]) -> StoreResult<bool> {
+    let Some(map) = map_of(packed) else { return Ok(false) };
+    let mut places = txn.open_multimap_table(PLACES).map_err(err)?;
+    if !places.remove(rb, packed).map_err(err)? {
+        return Ok(false);
+    }
+    let mut still = false;
+    for v in places.get(rb).map_err(err)? {
+        if map_of(v.map_err(err)?.value()) == Some(map) {
+            still = true;
+            break;
+        }
+    }
+    if !still {
+        txn.open_multimap_table(PLACED).map_err(err)?.remove(map, rb).map_err(err)?;
+    }
+    Ok(true)
+}
+
+/// drops every placement of an entry (it was forgotten or deleted)
+pub fn drop_entry(txn: &WriteTransaction, r: &Ref) -> StoreResult<usize> {
+    let rb = r.bytes();
+    let removed: Vec<Vec<u8>> = {
+        let mut places = txn.open_multimap_table(PLACES).map_err(err)?;
+        let mut out = Vec::new();
+        for v in places.remove_all(rb.as_slice()).map_err(err)? {
+            out.push(v.map_err(err)?.value().to_vec());
+        }
+        out
+    };
+    let mut placed = txn.open_multimap_table(PLACED).map_err(err)?;
+    for p in &removed {
+        if let Some(m) = map_of(p) {
+            placed.remove(m, rb.as_slice()).map_err(err)?;
+        }
+    }
+    Ok(removed.len())
+}
+
+fn clear_map(txn: &WriteTransaction, map: u16) -> StoreResult<usize> {
+    let refs: Vec<Vec<u8>> = {
+        let mut placed = txn.open_multimap_table(PLACED).map_err(err)?;
+        let mut out = Vec::new();
+        for v in placed.remove_all(map).map_err(err)? {
+            out.push(v.map_err(err)?.value().to_vec());
+        }
+        out
+    };
+    let mut places = txn.open_multimap_table(PLACES).map_err(err)?;
+    let mut n = 0;
+    for rb in refs {
+        let mut doomed = Vec::new();
+        for v in places.get(rb.as_slice()).map_err(err)? {
+            let v = v.map_err(err)?.value().to_vec();
+            if map_of(&v) == Some(map) {
+                doomed.push(v);
+            }
+        }
+        for v in doomed {
+            places.remove(rb.as_slice(), v.as_slice()).map_err(err)?;
+            n += 1;
+        }
+    }
+    Ok(n)
+}
+
+fn new_map(txn: &WriteTransaction, name: &str, id: Option<u16>) -> StoreResult<u16> {
+    let mut t = txn.open_table(PLACE_MAPS).map_err(err)?;
+    let id = match id {
+        Some(id) => id,
+        None => {
+            let last = t.last().map_err(err)?.map(|(k, _)| k.value()).unwrap_or(0);
+            last.checked_add(1).ok_or("there's no room for another map")?
+        }
+    };
+    if id == 0 {
+        return Err("0 isn't a map".into());
+    }
+    let meta = serde_json::to_vec(&Meta { name: name.to_string() }).map_err(err)?;
+    t.insert(id, meta.as_slice()).map_err(err)?;
+    Ok(id)
+}
+
+fn read_maps(txn: &redb::ReadTransaction) -> StoreResult<Vec<PlaceMap>> {
+    let t = txn.open_table(PLACE_MAPS).map_err(err)?;
+    let mut out = Vec::new();
+    for item in t.iter().map_err(err)? {
+        let (k, v) = item.map_err(err)?;
+        let name = serde_json::from_slice::<Meta>(v.value()).map(|m| m.name).unwrap_or_default();
+        out.push(PlaceMap { id: k.value(), name });
+    }
+    Ok(out)
+}
+
+impl Store {
+    /// places an entry; false when that very placement was there already
+    pub fn place(&self, r: &Ref, p: &Place) -> StoreResult<bool> {
+        let txn = self.db.begin_write().map_err(err)?;
+        if !exists(&txn, r)? {
+            return Err(format!("there's nothing under {}", r.label()));
+        }
+        if !map_exists(&txn, p.map)? {
+            return Err(format!("there's no map {}", p.map));
+        }
+        let new = insert(&txn, &r.bytes(), &p.pack())?;
+        txn.commit().map_err(err)?;
+        Ok(new)
+    }
+
+    /// moves a placement: the old one out and the new one in, at once
+    pub fn move_place(&self, r: &Ref, from: &Place, to: &Place) -> StoreResult<()> {
+        let txn = self.db.begin_write().map_err(err)?;
+        let rb = r.bytes();
+        if !remove(&txn, &rb, &from.pack())? {
+            return Err(format!("{} isn't placed there", r.label()));
+        }
+        if !map_exists(&txn, to.map)? {
+            return Err(format!("there's no map {}", to.map));
+        }
+        insert(&txn, &rb, &to.pack())?;
+        txn.commit().map_err(err)
+    }
+
+    /// takes a placement away; false when it wasn't there
+    pub fn unplace(&self, r: &Ref, p: &Place) -> StoreResult<bool> {
+        let txn = self.db.begin_write().map_err(err)?;
+        let gone = remove(&txn, &r.bytes(), &p.pack())?;
+        txn.commit().map_err(err)?;
+        Ok(gone)
+    }
+
+    /// every placement of an entry, in every map
+    pub fn places_of(&self, r: &Ref) -> StoreResult<Vec<Place>> {
+        let txn = self.db.begin_read().map_err(err)?;
+        let t = txn.open_multimap_table(PLACES).map_err(err)?;
+        let mut out = Vec::new();
+        for v in t.get(r.bytes().as_slice()).map_err(err)? {
+            if let Some(p) = Place::unpack(v.map_err(err)?.value()) {
+                out.push(p);
+            }
+        }
+        Ok(out)
+    }
+
+    /// what's placed in a map, entry by entry
+    pub fn places_in(&self, map: u16) -> StoreResult<Vec<(Ref, Place)>> {
+        let txn = self.db.begin_read().map_err(err)?;
+        let placed = txn.open_multimap_table(PLACED).map_err(err)?;
+        let places = txn.open_multimap_table(PLACES).map_err(err)?;
+        let mut out = Vec::new();
+        for rb in placed.get(map).map_err(err)? {
+            let rb = rb.map_err(err)?.value().to_vec();
+            let r = Ref::from_bytes(&rb);
+            for v in places.get(rb.as_slice()).map_err(err)? {
+                if let Some(p) = Place::unpack(v.map_err(err)?.value()).filter(|p| p.map == map) {
+                    out.push((r.clone(), p));
+                }
+            }
+        }
+        Ok(out)
+    }
+
+    /// every placement as stored: ref and packed value (unknown versions too)
+    pub fn all_places(&self) -> StoreResult<Vec<(Ref, Vec<u8>)>> {
+        let txn = self.db.begin_read().map_err(err)?;
+        let t = txn.open_multimap_table(PLACES).map_err(err)?;
+        let mut out = Vec::new();
+        for item in t.iter().map_err(err)? {
+            let (k, vs) = item.map_err(err)?;
+            let r = Ref::from_bytes(k.value());
+            for v in vs {
+                out.push((r.clone(), v.map_err(err)?.value().to_vec()));
+            }
+        }
+        Ok(out)
+    }
+
+    /// puts packed placements in as they are (a bundle's); ones of entries or maps that
+    /// aren't there are skipped. Returns how many were new.
+    pub fn import_places(&self, items: &[(Ref, Vec<u8>)]) -> StoreResult<usize> {
+        let txn = self.db.begin_write().map_err(err)?;
+        let mut n = 0;
+        for (r, v) in items {
+            let Some(map) = map_of(v) else { continue };
+            if exists(&txn, r)? && map_exists(&txn, map)? && insert(&txn, &r.bytes(), v)? {
+                n += 1;
+            }
+        }
+        txn.commit().map_err(err)?;
+        Ok(n)
+    }
+
+    pub fn place_maps(&self) -> StoreResult<Vec<PlaceMap>> {
+        let txn = self.db.begin_read().map_err(err)?;
+        read_maps(&txn)
+    }
+
+    pub fn place_map(&self, name: &str) -> StoreResult<Option<u16>> {
+        let name = name.trim();
+        Ok(self.place_maps()?.into_iter().find(|m| m.name == name).map(|m| m.id))
+    }
+
+    /// a new, empty map
+    pub fn create_place_map(&self, name: &str) -> StoreResult<u16> {
+        let name = check_name(name)?;
+        if self.place_map(&name)?.is_some() {
+            return Err(format!("there's a map named {name} already"));
+        }
+        let txn = self.db.begin_write().map_err(err)?;
+        let id = new_map(&txn, &name, None)?;
+        txn.commit().map_err(err)?;
+        Ok(id)
+    }
+
+    /// the map with this name, made if there isn't one
+    pub fn ensure_place_map(&self, name: &str) -> StoreResult<u16> {
+        match self.place_map(name)? {
+            Some(id) => Ok(id),
+            None => self.create_place_map(name),
+        }
+    }
+
+    /// a map under the id and name a bundle gave it (replacing what had that id)
+    pub fn import_place_map(&self, id: u16, name: &str) -> StoreResult<()> {
+        let txn = self.db.begin_write().map_err(err)?;
+        new_map(&txn, name, Some(id))?;
+        txn.commit().map_err(err)
+    }
+
+    pub fn rename_place_map(&self, id: u16, name: &str) -> StoreResult<()> {
+        let name = check_name(name)?;
+        if self.place_map(&name)?.is_some_and(|other| other != id) {
+            return Err(format!("there's a map named {name} already"));
+        }
+        let txn = self.db.begin_write().map_err(err)?;
+        if !map_exists(&txn, id)? {
+            return Err(format!("there's no map {id}"));
+        }
+        new_map(&txn, &name, Some(id))?;
+        txn.commit().map_err(err)
+    }
+
+    /// deletes a map and every placement in it; returns how many there were
+    pub fn delete_place_map(&self, id: u16) -> StoreResult<usize> {
+        let txn = self.db.begin_write().map_err(err)?;
+        if txn.open_table(PLACE_MAPS).map_err(err)?.remove(id).map_err(err)?.is_none() {
+            return Err(format!("there's no map {id}"));
+        }
+        let n = clear_map(&txn, id)?;
+        txn.commit().map_err(err)?;
+        Ok(n)
+    }
+
+    /// replaces everything in a map with these placements (their map ids are set to it),
+    /// in one transaction; returns how many distinct placements it holds now
+    pub fn set_map_places(&self, map: u16, items: &[(Ref, Place)]) -> StoreResult<usize> {
+        let txn = self.db.begin_write().map_err(err)?;
+        if !map_exists(&txn, map)? {
+            return Err(format!("there's no map {map}"));
+        }
+        clear_map(&txn, map)?;
+        let mut n = 0;
+        for (r, p) in items {
+            if !exists(&txn, r)? {
+                return Err(format!("there's nothing under {}", r.label()));
+            }
+            let p = Place { map, ..*p };
+            if insert(&txn, &r.bytes(), &p.pack())? {
+                n += 1;
+            }
+        }
+        txn.commit().map_err(err)?;
+        Ok(n)
+    }
+
+    /// turns the space's old JSON maps (`map:<name>` settings) into place maps, once
+    /// each: free texts are saturated (or found), memory texts placed as pinned spread
+    /// texts; sizes left out are `free_size` for free texts and `mem_size` for memory
+    /// ones. The old settings stay. Returns the names migrated and their placements.
+    pub fn migrate_legacy_maps(&self, free_size: f32, mem_size: f32) -> StoreResult<Vec<(String, usize)>> {
+        let names = self.setting_names(LEGACY_PREFIX)?;
+        let mut done: Vec<String> = self
+            .setting(MIGRATED)?
+            .and_then(|b| serde_json::from_slice(&b).ok())
+            .unwrap_or_default();
+        let todo: Vec<String> = names.into_iter().filter(|n| !done.contains(n)).collect();
+        if todo.is_empty() {
+            return Ok(Vec::new());
+        }
+        let mut out = Vec::new();
+        for name in todo {
+            done.push(name.clone());
+            let Some(rows) = self
+                .setting(&format!("{LEGACY_PREFIX}{name}"))?
+                .and_then(|b| serde_json::from_slice::<Vec<serde_json::Value>>(&b).ok())
+            else {
+                continue;
+            };
+            if check_name(&name).is_err() || self.place_map(&name)?.is_some() {
+                continue;
+            }
+            let mut items = Vec::new();
+            for row in rows.iter().filter_map(LegacyRow::read) {
+                let known = match row.key.as_deref().and_then(Ref::parse) {
+                    Some(r) if self.remember(&r).is_ok() => Some(r),
+                    _ => None,
+                };
+                let keyed = row.key.is_some();
+                let r = match known {
+                    Some(r) => r,
+                    None if row.text.trim().is_empty() => continue,
+                    None => Ref::Memory(self.saturate(&row.text)?.0),
+                };
+                let size = row.size.unwrap_or(if keyed { mem_size } else { free_size });
+                let color = row.color.as_deref().and_then(parse_hex_color).unwrap_or(INK);
+                let flags = if keyed { SPREAD | PINNED } else { PINNED };
+                items.push((r, Place::text(0, row.pos, size, color, flags)));
+            }
+            let id = self.create_place_map(&name)?;
+            let n = self.set_map_places(id, &items)?;
+            out.push((name, n));
+        }
+        self.set_setting(MIGRATED, &serde_json::to_vec(&done).map_err(err)?)?;
+        Ok(out)
+    }
+}
+
+/// the space's ink, the colour a text has when it says none
+pub const INK: [u8; 4] = [0x3b, 0x2a, 0x1c, 255];
+
+/// a row of an old map: `[text, x, y, z, {size, color, key}]`
+#[derive(Debug, Clone, PartialEq)]
+pub struct LegacyRow {
+    pub text: String,
+    pub pos: [f32; 3],
+    pub size: Option<f32>,
+    pub color: Option<String>,
+    /// "3,14" or "note:…"; old maps may hold a number
+    pub key: Option<String>,
+}
+
+impl LegacyRow {
+    pub fn read(v: &serde_json::Value) -> Option<LegacyRow> {
+        let a = v.as_array()?;
+        let num = |i: usize| a.get(i).and_then(|x| x.as_f64()).map(|x| x as f32);
+        let o = a.get(4);
+        let field = |k: &str| o.and_then(|o| o.get(k)).filter(|x| !x.is_null());
+        Some(LegacyRow {
+            text: a.first()?.as_str()?.to_string(),
+            pos: [num(1)?, num(2)?, num(3)?],
+            size: field("size").and_then(|x| x.as_f64()).map(|x| x as f32),
+            color: field("color").and_then(|x| x.as_str()).map(String::from),
+            key: field("key").map(|x| match x {
+                serde_json::Value::String(s) => s.clone(),
+                other => other.to_string(),
+            }),
+        })
+    }
+}
