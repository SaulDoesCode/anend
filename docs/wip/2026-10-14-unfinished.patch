+    #[test]
+    fn table_ops() {
+        let (s, path) = store("ops");
+        let a = Ref::Memory(s.saturate_new("alpha").unwrap());
+        let b = Ref::Memory(s.saturate_new("beta").unwrap());
+        let note = s.save(&crate::note::Note { title: "n".into(), ..Default::default() }).unwrap();
+        let n = Ref::Note(note.key.clone());
+        let home = s.create_place_map("home").unwrap();
+        let work = s.create_place_map("work").unwrap();
+        assert_eq!((home, work), (1, 2));
+        assert!(s.create_place_map(" home ").is_err());
+        assert!(s.create_place_map("  ").is_err());
+
+        let p1 = Place::text(home, [1.0, 2.0, 3.0], 0.5, INK, PINNED);
+        let p2 = Place::text(home, [4.0, 5.0, 6.0], 0.5, INK, PINNED);
+        assert!(s.place(&a, &p1).unwrap());
+        assert!(!s.place(&a, &p1).unwrap(), "the same placement collapses");
+        assert!(s.place(&a, &p2).unwrap());
+        assert!(s.place(&a, &Place { map: work, ..p1 }).unwrap());
+        assert!(s.place(&n, &p1).unwrap());
+        assert!(s.place(&Ref::Memory(vec![99]), &p1).is_err());
+        assert!(s.place(&b, &Place { map: 77, ..p1 }).is_err());
+
+        assert_eq!(s.places_of(&a).unwrap().len(), 3);
+        assert_eq!(s.places_in(home).unwrap().len(), 3);
+        assert_eq!(s.places_in(work).unwrap(), vec![(a.clone(), Place::unpack(&Place { map: work, ..p1 }.pack()).unwrap())]);
+
+        // moving: the old one out, the new one in
+        let p3 = Place::text(home, [7.0, 8.0, 9.0], 1.0, [255, 0, 0, 255], 0);
+        s.move_place(&a, &p2, &p3).unwrap();
+        assert!(s.move_place(&a, &p2, &p3).is_err());
+        let mut in_home: Vec<[f32; 3]> = s.places_in(home).unwrap().iter().map(|(_, p)| p.pos).collect();
+        in_home.sort_by(|x, y| x.partial_cmp(y).unwrap());
+        assert_eq!(in_home, [[1.0, 2.0, 3.0], [1.0, 2.0, 3.0], [7.0, 8.0, 9.0]]);
+
+        // the reverse index keeps a ref while it has a placement in the map
+        assert!(s.unplace(&a, &p1).unwrap());
+        assert!(!s.unplace(&a, &p1).unwrap());
+        assert_eq!(s.places_in(home).unwrap().len(), 2);
+        assert!(s.unplace(&a, &p3).unwrap());
+        assert_eq!(s.places_in(home).unwrap(), vec![(n.clone(), Place::unpack(&p1.pack()).unwrap())]);
+
+        // maps: rename, list, delete takes its placements
+        s.rename_place_map(work, "office").unwrap();
+        assert!(s.rename_place_map(work, "home").is_err());
+        assert_eq!(s.place_map("office").unwrap(), Some(work));
+        assert_eq!(
+            s.place_maps().unwrap().iter().map(|m| m.name.as_str()).collect::<Vec<_>>(),
+            ["home", "office"]
+        );
+        assert_eq!(s.delete_place_map(work).unwrap(), 1);
+        assert!(s.delete_place_map(work).is_err());
+        assert!(s.places_of(&a).unwrap().is_empty());
+        assert_eq!(s.create_place_map("again").unwrap(), 2);
+
+        // set_map_places replaces a map's contents
+        let items = vec![(a.clone(), p1), (b.clone(), p2), (b.clone(), p2)];
+        assert_eq!(s.set_map_places(home, &items).unwrap(), 2);
