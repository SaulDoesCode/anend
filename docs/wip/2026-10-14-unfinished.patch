+    /// a small deterministic generator
+    struct Lcg(u64);
+    impl Lcg {
+        fn next(&mut self) -> u32 {
+            self.0 = self.0.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            (self.0 >> 32) as u32
+        }
+        fn unit(&mut self) -> f32 {
+            self.next() as f32 / u32::MAX as f32 * 2.0 - 1.0
+        }
+    }
+
+    fn sample() -> Place {
+        Place {
+            kind: Kind::Brick,
+            map: 513,
+            flags: PINNED | SPREAD | 0x80,
+            pos: [1.25, -3.5e7, 0.1],
+            rot: [0.1, -0.7, 0.2, 0.68],
+            scale: [0.5, 2.0, -1.5],
+            color: [1, 2, 3, 4],
+            asset: 0xdead_beef,
+        }
+    }
+
+    #[test]
+    fn layout_is_fixed() {
+        let b = sample().pack();
+        assert_eq!(b.len(), PACKED);
+        assert_eq!(b[0], 1);
+        assert_eq!(b[1], 3);
+        assert_eq!(&b[2..4], &[1, 2]); // 513 little endian
+        assert_eq!(b[4], 0x85);
+        assert_eq!(b[5], 0);
+        assert_eq!(&b[6..10], &1.25f32.to_le_bytes());
+        assert_eq!(&b[22..24], &0x3800u16.to_le_bytes()); // 0.5 in f16
+        assert_eq!(&b[26..28], &0xbe00u16.to_le_bytes()); // -1.5
+        assert_eq!(&b[28..32], &[1, 2, 3, 4]);
+        assert_eq!(&b[32..36], &0xdead_beefu32.to_le_bytes());
+        // identity: w is the big one (index 3), the others at the middle step
+        let id = pack_rotation(IDENTITY);
+        assert_eq!(id, (3 << 30) | (511 << 20) | (511 << 10) | 511);
+        assert_eq!(unpack_rotation(id), IDENTITY);
+        assert_eq!(map_of(&b), Some(513));
+        assert_eq!(map_of(&with_map(&b, 7)), Some(7));
+    }
+
+    #[test]
+    fn round_trip_and_idempotence() {
+        let p = sample();
+        let q = Place::unpack(&p.pack()).unwrap();
+        assert_eq!((q.kind, q.map, q.flags, q.pos, q.color, q.asset), (p.kind, p.map, p.flags, p.pos, p.color, p.asset));
+        assert_eq!(q.scale, [0.5, 2.0, -1.5]);
+        assert_eq!(q.pack(), p.pack());
+        // other sizes, versions and kinds don't unpack
+        let mut b = p.pack();
+        assert!(Place::unpack(&b[..35]).is_none());
+        b[0] = 2;
+        assert!(Place::unpack(&b).is_none());
+        let mut b = p.pack();
+        b[1] = 9;
+        assert!(Place::unpack(&b).is_none());
+
+        let mut g = Lcg(7);
+        for _ in 0..20_000 {
+            let p = Place {
+                kind: Kind::from_u8((g.next() % 5) as u8).unwrap(),
+                map: g.next() as u16,
+                flags: g.next() as u8,
+                pos: [g.unit() * 1e4, g.unit(), g.unit() * 1e-3],
+                rot: [g.unit(), g.unit(), g.unit(), g.unit()],
+                scale: [g.unit() * 100.0, g.unit(), g.unit() * 1e-3],
+                color: g.next().to_le_bytes(),
+                asset: g.next(),
+            };
+            let b = p.pack();
+            let q = Place::unpack(&b).unwrap();
+            assert_eq!(q.pack(), b, "{p:?}");
+            assert_eq!(q.pos, p.pos);
+            for i in 0..3 {
+                // f16: half an ulp of 11 significant bits, or the subnormal step
+                let tol = (p.scale[i].abs() * (1.0 / 2048.0)).max(1.0 / 33_554_432.0);
+                assert!((q.scale[i] - p.scale[i]).abs() <= tol, "{} vs {}", q.scale[i], p.scale[i]);
+            }
+            // the same rotation (q or -q), within the quantisation
+            let len = p.rot.iter().map(|v| v * v).sum::<f32>().sqrt();
+            if len > 1e-6 {
+                let dot: f32 = p.rot.iter().zip(q.rot).map(|(a, b)| a / len * b).sum();
+                let angle = 2.0 * dot.abs().min(1.0).acos();
+                assert!(angle.to_degrees() < 0.25, "{angle} for {:?}", p.rot);
+            }
+            let ql: f32 = q.rot.iter().map(|v| v * v).sum();
+            assert!((ql - 1.0).abs() < 2e-3);
+        }
+    }
+
+    #[test]
+    fn canonical_values() {
+        let base = Place::text(1, [0.0; 3], 0.5, INK, 0);
+        let with = |f: &dyn Fn(&mut Place)| {
+            let mut p = base;
+            f(&mut p);
+            p.pack()
+        };
+        // -0 is 0, NaN is 0 (scale 1), infinities clamp
+        assert_eq!(with(&|p| p.pos = [-0.0, -0.0, -0.0]), base.pack());
+        assert_eq!(with(&|p| p.pos[0] = f32::NAN), base.pack());
+        let inf = Place::unpack(&with(&|p| p.pos = [f32::INFINITY, f32::NEG_INFINITY, 1.0])).unwrap();
+        assert_eq!(inf.pos, [f32::MAX, f32::MIN, 1.0]);
+        assert_eq!(with(&|p| p.scale[0] = -0.0), with(&|p| p.scale[0] = 0.0));
+        assert_eq!(Place::unpack(&with(&|p| p.scale = [f32::NAN; 3])).unwrap().scale, [1.0; 3]);
+        assert_eq!(Place::unpack(&with(&|p| p.scale = [1e9, -1e9, 70000.0])).unwrap().scale, [65504.0, -65504.0, 65504.0]);
+        // rotations: q and -q, scaled or not, are the same bytes; zero and NaN are the identity
+        let r = [0.3, -0.5, 0.1, -0.8];
+        let neg = r.map(|v: f32| -v);
+        let big = r.map(|v: f32| v * 9.0);
+        assert_eq!(pack_rotation(r), pack_rotation(neg));
+        assert_eq!(pack_rotation(r), pack_rotation(big));
+        assert_eq!(pack_rotation([0.0; 4]), pack_rotation(IDENTITY));
+        assert_eq!(pack_rotation([f32::NAN, 0.0, 0.0, 1.0]), pack_rotation(IDENTITY));
+        // the largest component comes back positive
+        let u = unpack_rotation(pack_rotation(r));
+        assert!(u[3] > 0.0 && u[0] < 0.0 && u[1] > 0.0);
+        // a quarter turn about z: x y both zero, a tie between z and w picks z
+        let h = std::f32::consts::FRAC_1_SQRT_2;
+        let qt = unpack_rotation(pack_rotation([0.0, 0.0, h, h]));
+        assert!((qt[2] - h).abs() < 1e-3 && (qt[3] - h).abs() < 2e-3);
+        assert_eq!(pack_rotation(qt), pack_rotation([0.0, 0.0, h, h]));
+        // every axis as the largest
+        for big in 0..4 {
+            let mut q = [0.1f32, -0.2, 0.15, 0.05];
+            q[big] = -0.9;
+            let b = pack_rotation(q);
+            assert_eq!((b >> 30) as usize, big);
+            assert!(unpack_rotation(b)[big] > 0.0);
+        }
+    }
+
+    #[test]
+    fn f16_every_value() {
+        for h in 0..=u16::MAX {
+            let v = f16_to_f32(h);
+            if v.is_nan() {
+                assert!(f32_to_f16(v) & 0x7c00 == 0x7c00 && f32_to_f16(v) & 0x3ff != 0);
+                continue;
+            }
+            assert_eq!(f32_to_f16(v), h, "{h:#06x} {v}");
+        }
+        assert_eq!(f32_to_f16(1.0), 0x3c00);
+        assert_eq!(f32_to_f16(65504.0), 0x7bff);
+        assert_eq!(f32_to_f16(65520.0), 0x7c00); // rounds to infinity (place() clamps first)
+        assert_eq!(f16_to_f32(0x0001), 5.960_464_5e-8);
+        // ties go to even: 1 + 2^-11 is between 1 and 1 + 2^-10
+        assert_eq!(f32_to_f16(1.0 + 1.0 / 2048.0), 0x3c00);
+        assert_eq!(f32_to_f16(1.0 + 3.0 / 2048.0), 0x3c02);
+        assert_eq!(f32_to_f16(1e-9), 0);
+        assert_eq!(f32_to_f16(-1e-9), 0x8000);
+    }
