+                    {
+                        let key = a["key"].as_str().unwrap_or("").to_string();
+                        let name = a["anim"]["name"].as_str().filter(|n| !n.is_empty()).map(str::to_string).unwrap_or_else(|| format!("animation {key}"));
+                        let on = o.as_ref().and_then(|x| x.0.clone()) == Some(key.clone());
