+                recipes.set(
+                    r.as_array()
+                        .into_iter()
+                        .flatten()
+                        .map(|t| {
+                            let id = t["id"].as_str().unwrap_or("").to_string();
+                            let name = t["name"].as_str().filter(|n| !n.is_empty()).map(str::to_string).unwrap_or_else(|| id.chars().take(8).collect());
