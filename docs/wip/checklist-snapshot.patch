+                            oninput: move |e| { scrub.set(e.value().parse().unwrap_or(0.0)); playing.set(false); } }
+                    }
+                    div { class: "row wrap",
+                        span { class: "dim small", {format!("{:.0}%", scrub() * 100.0)} }
+                        button { class: "btn small", title: "a key at this moment, with the pose it has here",
