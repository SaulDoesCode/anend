# anend hub as a systemd service. Copy to /etc/systemd/system/anend-hub.service, make
# the user and folder, then:  systemctl daemon-reload && systemctl enable --now anend-hub
#
#   useradd --system --home /var/lib/anend-hub --shell /usr/sbin/nologin anend
#   install -d -o anend -g anend /var/lib/anend-hub
#   install -m 755 anend-hub /usr/local/bin/
#
# What it runs: --mode both (the default), hub (the sharing site alone) or app (the web
# app alone); --join invite (the default for a new server), apply or open. For a daemon
# only you use, on your own machine, use --local and keep the address on 127.0.0.1. For
# https, give --tls-cert and --tls-key (readable by the anend user), or put it behind a
# proxy (as below). Terms and privacy: terms.md and privacy.md in /var/lib/anend-hub
# (examples in hub/config/). docs/deploy.md has the rest. Stopping waits for requests in
# flight (up to 20 s).

[Unit]
Description=anend hub: shared saves, the web app and its API
After=network-online.target
Wants=network-online.target

[Service]
User=anend
Group=anend
WorkingDirectory=/var/lib/anend-hub
ExecStart=/usr/local/bin/anend-hub --data /var/lib/anend-hub --addr 127.0.0.1:8080 --url https://hub.example.org --behind-proxy --mode both --join invite --log json
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

# keep it to its own folder
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/anend-hub

[Install]
WantedBy=multi-user.target
